#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define HOME_LAYER 0
#define NUMBER_LAYER 1
#define SYSTEM_LAYER 2
#define BLUETOOTH_LAYER 3

&mt {
  quick-tap-ms = <100>;
  global-quick-tap;
  flavor = "tap-preferred";
  tapping-term-ms = <170>;
};

/ {
    combos {
            compatible = "zmk,combos";
            combo_esc {
                timeout-ms = <50>;
                key-positions = <10 01>;
                bindings = <&kp ESC>;
            };
                
            combo_left_esc {
                timeout-ms = <50>;
                key-positions = <00 01>;
                bindings = <&kp ESC>;
        
            };

        combo_left_sys_reset {
            timeout-ms = <50>;
            key-positions = <00 20>;
            bindings = <&sys_reset>;

            };

        combo_left_bootloader {
            timeout-ms = <50>;
            key-positions = <04 24>;
            bindings = <&bootloader>;
            
            };

        combo_right_bootloader {
            timeout-ms = <50>;
            key-positions = <05 25>;
            bindings = <&bootloader>;
            
            };

        combo_right_sys_reset {
            timeout-ms = <50>;
            key-positions = <09 29>;
            bindings = <&sys_reset>;
        
        };

        combo_right_esc {
            timeout-ms = <50>;
            key-positions = <08 09>;
            bindings = <&kp ESC>;
            };
    };

    macros {
        gif: gif {
            label = "giphy";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LSHFT>
                , <&macro_tap &kp N2>
                , <&macro_release &kp LSHFT>
                , <&macro_tap &kp G &kp I &kp F>;
        };

        gm_dot: gmail_with_a_dot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <20>;
            bindings = <
                &kp D &kp A &kp V &kp I &kp D &kp DOT &kp L &kp E &kp D &kp G &kp E &kp R &kp W &kp O &kp O &kp D &kp N1 &kp N6 &kp N5
                &kp AT
                &kp G &kp M &kp A &kp I &kp L &kp DOT &kp C &kp O &kp M>;
        };

    
        ext_gif: dot: gif {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <20>;
            bindings = <&kp DOT &kp G &kp I &kp F>;
        };

        em_bt: bt_email {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <20>;
            bindings = <
                &kp D &kp A &kp V &kp I &kp D &kp L &kp E &kp D &kp G &kp E &kp R &kp W &kp O &kp O &kp D &kp N1 &kp N6 &kp N5
                &kp AT
                &kp B &kp T &kp I &kp N &kp T &kp E &kp R &kp N &kp E &kp T &kp DOT &kp C &kp O &kp M>;
        };

        pw_lh: password_lh {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <20>;
            bindings = 
                <&macro_press &kp LSHFT>,
                <&macro_tap &kp L>,
                <&macro_release &kp LSHFT>,
                <&macro_tap &kp I &kp L &kp L &kp Y >,
                <&macro_tap &kp P &kp A &kp S &kp S>,
                <&macro_press &kp LSHFT>,
                <&macro_press &kp N7>,
                <&macro_release &kp LSHFT>,
                <&macro_tap &kp N1 &kp N2 &kp N3 &kp N4>,
                <&macro_press &kp LSHFT>,
                <&macro_tap &kp H>,
                <&macro_release &kp LSHFT>,
                <&macro_tap &kp A &kp R &kp R &kp Y>;
                
        };
    };

    behaviors {
        t_l_t_kp: toggle_layer_tap_keypress {
                compatible = "zmk,behavior-hold-tap";
                #binding-cells = <2>;
                flavor = "hold-preferred";
                tapping-term-ms =<300>;
                bindings = <&to>, <&kp>;
        };

        c_h_t: custom_hold_tap {
                compatible = "zmk,behavior-hold-tap";
                #binding-cells = <2>;
                flavor = "balanced";
                tapping-term-ms =<170>;
                quick-tap-ms = <100>
                bindings = <&kp>, <&kp>; 
        };

        one_pipe: one_pipe {
                compatible = "zmk,behavior-hold-tap";
                #binding-cells = <0>;
                bindings = <&kp N1>, <&kp PIPE>;
                keep-mods = <0>;
                mods = <(MOD_LSFT)>;
        };

        bk_xcl: backslash_shriek {
                compatible = "zmk,behavior-hold-tap";
                #binding-cells = <0>;
                bindings = <&kp BACKSLASH>, <&kp EXCLAMATION>;
                keep-mods = <0>;
                mods = <(MOD_LSFT)>;
        }
    }

        keymap {
                compatible = "zmk,keymap";

                home_layer {
// ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
label= "HOME"                              ;
// ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
//             ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓   ┃      Z    ┃   Q       ┃     U     ┃     D     ┃   X       ┃
//             ┃      W    ┃     L     ┃    R      ┃     B     ┃     J     ┃   ┃      Z    ┃   Q       ┃     U     ┃     D     ┃   X       ┃
//             ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┃    APOS   ┃   A       ┃     E     ┃     I     ┃     O     ┃
//             ┃      S    ┃     H     ┃    N      ┃     T     ┃   ;       ┃   ┃    APOS   ┃   A       ┃     E     ┃     I     ┃     O     ┃
// ┏━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┃   .       ┃   P       ┃     G     ┃    K      ┃    Y      ┃           ┃
// ┃           ┃      F    ┃     M     ┃    V      ┃     C     ┃    ,      ┃   ┃   .       ┃   P       ┃     G     ┃    K      ┃    Y      ┃           ┃
// ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┃  RGUI BSP ┃RSHFT SPACE┃ LCTRL TAB ┃ALT RET     sys_reset
//               sys_reset   ALT RET   ┃ LCTRL TAB ┃RSHFT SPACE┃ RGUI BSP  ┃   ┃  RGUI BSP ┃RSHFT SPACE┃ LCTRL TAB ┃ALT RET     sys_reset
//                                   ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛   ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
 bindings = <
// ╷           ╷             ╷             ╷               ╷                 ╷           ╷     ╷             ╷               ╷             ╷             ╷           ╷

                &kp W            &kp L            &kp R            &kp B              &kp J              &kp Z              &kp Q              &kp U            &kp D            &kp X
                &t_l_t_kp 2 S    &t_l_t_kp 0 H    &t_l_t_kp 1 N    &t_l_t_kp 3 T      &kp SEMI           &kp APOS           &kp A              &kp E            &kp O            &kp I  
                &kp F            &kp M            &kp  V           &kp C              &kp COMMA          &kp DOT            &kp P              &kp G            &kp K            &kp Y
                &c_h_t RALT DEL  &c_h_t LALT RET  &c_h_t LGUI TAB  &c_h_t LSFT SPACE  &c_h_t LCTRL BSPC  &c_h_t LCTRL BSPC  &c_h_t LSFT SPACE  &c_h_t LGUI TAB  &c_h_t LALT RET  &c_h_t RALT DEL   
                          >;
                };

// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄


                number_layer {
// ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
label= "NUMBER"                              ;
// ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
//             ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓   ┃   trans   ┃    BKT    ┃   RBKT    ┃   BSLH    ┃   FLSH    ┃
//             ┃     7     ┃     8     ┃     9     ┃    0      ┃   trans   ┃   ┃   trans   ┃    BKT    ┃   RBKT    ┃   BSLH    ┃   FLSH    ┃
//             ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┃   trans   ┃   LEFT    ┃    UP     ┃    DN     ┃   RIGHT   ┃
//             ┃     4     ┃     5     ┃     6     ┃btooth/grave ┃ trans   ┃   ┃   trans   ┃   LEFT    ┃    UP     ┃    DN     ┃   RIGHT   ┃
// ┏━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┃   trans   ┃   EQUAL   ┃   MINUS   ┃     &gif  ┃    ESC    ┃           ┃
// ┃           ┃     1     ┃     2     ┃     3     ┃   trans   ┃   trans   ┃   ┃   trans   ┃   EQUAL   ┃   MINUS   ┃     &gif  ┃    ESC    ┃           ┃
// ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┃   trans   ┃   trans   ┃   trans   ┃   trans      trans
//                 trans      trans    ┃   trans   ┃   trans   ┃   trans   ┃   ┃   trans   ┃   trans   ┃   trans   ┃   trans      trans
//                                     ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛   ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
 bindings = <
// ╷           ╷             ╷            ╷              ╷                    ╷      ╷  ╷          ╷          ╷          ╷           ╷           ╷

                &kp N7          &kp N8           &kp N9           &kp N0              &trans            &trans            &kp LBKT          &kp RBKT         &bk_xcl           &kp FLSH 
                &t_l_t_kp 2 N4  &t_l_t_kp 0 N5   &t_l_t_kp 1 N6   &t_l_t_kp 3 GRAVE   &trans            &trans            &kp LEFT          &kp UP           &kp DN            &kp RIGHT  
                &one_pipe       &kp N2           &kp N3           &trans              &trans            &trans            &kp EQUAL         &kp MINUS        &pw_lh            &trans            
                &c_h_t RALT DEL &c_h_t LALT RET  &c_h_t LGUI TAB  &c_h_t LSFT SPACE   &c_h_t LCTRL BSPC &c_h_t LCTRL BSPC &c_h_t LSFT SPACE &c_h_t LGUI TAB  &c_h_t LALT RET   &c_h_t RALT DEL       
                          >;
                };

// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄


                system_layer {
// ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
label= "SYSTEM"                               ;
// ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
//             ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓   ┃&trans┃ &kpC_MUTE ┃&kp C_VOL_DN┃ &kp C_VOL_UP ┃ &trans
//             ┃ &kp PG UP ┃ &kp PG DN ┃   &trans  ┃       &trans        &trans  ┃  ┃&trans┃ &kpC_MUTE ┃&kp C_VOL_DN┃ &kp C_VOL_UP ┃ &trans
//             ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┃&kp F6┃    &kp F7 ┃   &kp F8  ┃  &kp F9   ┃  &kp F10  ┃
//             ┃ SYSTEM F1 ┃  HOME F2  ┃ NUMBER F3 ┃&lt BLUETOOTH  F4    &kp F5  ┃  ┃&kp F6┃    &kp F7 ┃   &kp F8  ┃  &kp F9   ┃  &kp F10  ┃
// ┏━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┃&trans┃  &trans   ┃  &trans   ┃  &trans   ┃    ESC    ┃           ┃
// ┃           ┃kp C_BRI_UP┃C_BRI_DN   ┃ &trans    ┃       &trans        &trans  ┃  ┃&trans┃  &trans   ┃  &trans   ┃  &trans   ┃    ESC    ┃           ┃
// ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┃trans ┃   &trans  ┃   &trans  ┃&trans        &trans
//                 &trans     &trans   ┃   &trans  ┃        &trans       &trans  ┃  ┃trans ┃   &trans  ┃   &trans  ┃&trans        &trans
//                                     ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛   ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
 bindings = <
// ╷           ╷              ╷             ╷              ╷                   ╷        ╷   ╷           ╷              ╷             ╷             ╷           ╷           ╷

                &kp PG_UP        &kp PG_DN        &kp C_VOL_UP     &kp C_VOL_DN        &trans             &trans             &kp C_MUTE         &kp C_NEXT       &kp C_PREV       &kp C_PP      
                &t_l_t_kp 2 F1   &t_l_t_kp 0 F2   &t_l_t_kp 1 F3   &t_l_t_kp 3 F4      &kp F5             &kp F6             &kp F7             &kp F8           &kp F9           &kp F10
                &kp C_BRI_UP     &kp C_BRI_DN     &trans           &trans              &trans             &trans             &ext_gif           &em_bt           &gm_dot          &trans            
                &c_h_t RALT DEL  &c_h_t LALT RET  &c_h_t LGUI TAB  &c_h_t LSFT SPACE   &c_h_t LCTRL BSPC  &c_h_t LCTRL BSPC  &c_h_t LSFT SPACE  &c_h_t LGUI TAB  &c_h_t LALT RET  &c_h_t RALT DEL
                     >;
                };

// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄


                bluetooth_layer {
// ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
label= "BLUETOOTH"                               ;
// ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
//             ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓   ┃    &trans  ┃   &trans   ┃   &trans   ┃   &trans   ┃   &trans   ┃
//             ┃   &trans  ┃  &trans   ┃   &trans  ┃  &trans   ┃   &trans  ┃   ┃    &trans  ┃   &trans   ┃   &trans   ┃   &trans   ┃   &trans   ┃
//             ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┃  &kp F16   ┃  &kp F17   ┃  &kp F18   ┃  &kp F19   ┃   &kp F20  ┃
//             ┃SYSTEM F11 ┃  HOME F12 ┃ NUMBER F13┃ BTOOTH F14┃  &kp F15  ┃   ┃  &kp F16   ┃  &kp F17   ┃  &kp F18   ┃  &kp F19   ┃   &kp F20  ┃
